index 0000000..a46b87a
--- /dev/null
+++ b/src/Search/CombatBeamSolver.BfwsResearch.cs
@@ -0,0 +1,327 @@
+using System.Diagnostics;
+using System.Numerics;
+using CombatSolver.Engine.InCombat.Simulation;
+
+namespace CombatSolver;
+
+internal sealed partial class CombatBeamSolver
+{
+    private ResearchRun _research => _run.Research;
+    private sealed class ResearchRun
+    {
+        public long Generated;
+        public int PeakOpen;
+        public int HorizonLeaves;
+        public int NonNovelPruned;
+        public int FamiliarAdmitted;
+        public int OpenDropped;
+        public int Wins;
+        public long? FirstVictoryMs;
+        public int? FirstVictoryExpanded;
+        public int? MinimumCumulativeLoss;
+        public int? MinimumLossExpanded;
+        public long? MinimumLossMs;
+        public IReadOnlyList<PlanAction>? MinimumLossActions;
+        public string Stop = "not_started";
+        public int NoveltyEntries;
+        public int NoveltyAtoms;
+        public int NoveltyPartitions;
+        public long Unary;
+        public long Binary;
+        public long Familiar;
+        public List<object> Improvements = [];
+        public List<BfwsFact> Facts = [];
+        public Dictionary<(string Id, int Upgrade), int> ZoneCounts = [];
+        public List<(string Id, int Upgrade)> ZoneOrder = [];
+        public object Describe() => new { Generated, PeakOpen, HorizonLeaves, NonNovelPruned, FamiliarAdmitted, OpenDropped, Wins, FirstVictoryMs,
+            FirstVictoryExpanded, MinimumCumulativeLoss, MinimumLossExpanded, MinimumLossMs,
+            MinimumLossActions, Stop, NoveltyEntries, NoveltyAtoms, NoveltyPartitions,
+            Unary, Binary, Familiar, Improvements };
+    }
+    private void ObserveResearchCandidate(SearchNode node, Stopwatch clock)
+    {
+        if (policy.Research == null) return;
+        _research.Generated++;
+        var s = node.Snapshot;
+        if (!s.AllEnemiesDead || s.PlayerDead || s.HasRisk || s.BoundaryReason != SearchBoundaryReason.None) return;
+        _research.Wins++;
+        _research.FirstVictoryMs ??= clock.ElapsedMilliseconds;
+        _research.FirstVictoryExpanded ??= _run.Expanded;
+        if (_research.MinimumCumulativeLoss is { } previous && previous <= s.CumulativePlayerHpLost) return;
+        _research.MinimumCumulativeLoss = s.CumulativePlayerHpLost;
+        _research.MinimumLossExpanded = _run.Expanded;
+        _research.MinimumLossMs = clock.ElapsedMilliseconds;
+        _research.MinimumLossActions = node.Actions.ToArray();
+        _research.Improvements.Add(new { elapsedMs = clock.ElapsedMilliseconds, expanded = _run.Expanded,
+            loss = s.CumulativePlayerHpLost, potions = node.PotionCount, turn = node.Turn });
+    }
+
+    private bool RunResearchOpen(List<SearchNode> initial, List<SearchNode> completed,
+        Stopwatch clock, ref SearchNode fallback, Func<SearchNode, bool> hpTarget,
+        Func<SearchNode, int, int, bool> beforeParent,
+        Action<SearchNode, int, int> afterParent, Action<SearchNode> observeBoundary,
+        out bool targetReached, out int turnLayers)
+    {
+        BfwsResearchOptions options = policy.Research!;
+        if (options.Scheduler is not ("gbfs" or "bfws" or "exact")
+            || options.Features is not ("coarse" or "structured") || options.MaxOpen < 1
+            || options.Encoding is not ("legacy" or "packed" or "delta")
+            || options.MaxTurns < 1 || options.MaxActions < 1 || options.FamiliarAllowance < 0)
+            throw new InvalidOperationException("Invalid research search options.");
+        PriorityQueue<(SearchNode Node, BfwsEscapeBudget? Escape), (double Primary, double Secondary, long Sequence)> open = new();
+        BfwsBoundedOpen<(SearchNode Node, BfwsEscapeBudget? Escape)>? bounded = options.BoundedOpen ? new(options.MaxOpen) : null;
+        int OpenCount() => bounded?.Count ?? open.Count;
+        IEnumerable<(SearchNode Node, BfwsEscapeBudget? Escape)> OpenEntries()
+            => bounded?.Values ?? open.UnorderedItems.Select(item => item.Element);
+        var novelty = new BfwsResearchNovelty(options.Width, options.MaxNoveltyEntries);
+        BfwsPackedNovelty? packed = options.Encoding == "legacy" ? null : new(options.Width, options.MaxNoveltyEntries);
+        long sequence = 0;
+        List<SearchNode> noveltyDropped = [];
+        int maximumTurn = _startTurnNumber;
+        bool stopped = false;
+        targetReached = false;
+        _research.Stop = "open_exhausted";
+        foreach (SearchNode seed in initial) Enqueue(seed, initialSeed: true);
+        initial.Clear();
+        try
+        {
+            while (OpenCount() > 0)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+                if (_run.Expanded >= _profile.MaxExpandedNodes) { _research.Stop = "node_limit"; break; }
+                if (clock.ElapsedMilliseconds >= _profile.SoftTimeBudgetMilliseconds)
+                { _research.Stop = "time_limit"; stopped = true; break; }
+                var (parent, escape) = bounded is null ? open.Dequeue() : bounded.Dequeue();
+                try
+                {
+                    if (parent.ActionCount >= options.MaxActions || parent.Turn >= _startTurnNumber + options.MaxTurns)
+                    { _research.HorizonLeaves++; continue; }
+                    if (!options.RawFinite && !beforeParent(parent, OpenCount(), completed.Count))
+                    { _research.Stop = "adoption"; stopped = true; break; }
+                    BeginCyclePlanningLayer();
+                    if (options.Scheduler == "bfws" && options.Encoding == "delta")
+                        packed!.PrepareParent((parent.Snapshot.EnemyHp / 10, parent.PotionCount), CapturePackedFacts(parent, options.Features));
+                    List<SearchNode> children = [];
+                    try
+                    {
+                        foreach (SearchNode generated in options.RawFinite ? ExpandResearchRaw(parent) : Expand(parent)) children.Add(generated);
+                        if (!options.RawFinite)
+                        {
+                            List<SearchNode> boundaries = children.Where(n => n.IsTerminal || n.Turn > parent.Turn).ToList();
+                            List<SearchNode> annotated = AnnotateTurnOutcomes(boundaries);
+                            ReleaseDroppedSnapshots(boundaries, annotated);
+                            children = children.Where(n => !n.IsTerminal && n.Turn == parent.Turn).Concat(annotated).ToList();
+                        }
+                        foreach (SearchNode child in children)
+                        {
+                            ObserveResearchCandidate(child, clock);
+                            maximumTurn = Math.Max(maximumTurn, child.Turn);
+                            if (child.Score > fallback.Score) fallback = child;
+                            if (!options.RawFinite && (child.IsTerminal || child.Turn > parent.Turn))
+                                observeBoundary(child);
+                            if (child.IsTerminal)
+                            {
+                                if (options.Scheduler == "bfws") _ = NoveltyFor(child);
+                                completed.Add(child);
+                                if (!options.RawFinite) targetReached |= hpTarget(child);
+                            }
+                            else Enqueue(child, parentEscape: escape);
+                        }
+                        if (noveltyDropped.Count > 0)
+                        {
+                            // A published sibling can share the same snapshot. Release by snapshot
+                            // identity only after every successor has reached its final owner.
+                            List<SearchNode> retained = OpenEntries().Select(item => item.Node)
+                                .Concat(completed).Append(parent).ToList();
+                            ReleaseDroppedSnapshots(noveltyDropped, retained);
+                            noveltyDropped.Clear();
+                        }
+                        children.Clear(); // Ownership moved to OPEN or completed, or released above.
+                    }
+                    finally { foreach (SearchNode child in children) child.Snapshot.ReleaseSimulator(); }
+                    if (completed.Count > 64)
+                    {
+                        List<SearchNode> ranked = Retention.RankFinal(completed);
+                        ReleaseDroppedSnapshots(completed, ranked);
+                        completed.Clear(); completed.AddRange(ranked);
+                    }
+                }
+                finally { parent.Snapshot.ReleaseSimulator(); }
+                if (!options.RawFinite) afterParent(parent, OpenCount(), completed.Count);
+                if (targetReached) { _research.Stop = "hp_target"; break; }
+                if (open.Count > options.MaxOpen) { _research.Stop = "open_limit"; break; }
+                if (packed?.LimitReached ?? novelty.LimitReached) { _research.Stop = "novelty_limit"; break; }
+            }
+            turnLayers = Math.Max(0, maximumTurn - _startTurnNumber);
+            return stopped;
+        }
+        finally
+        {
+            foreach (var pending in OpenEntries()) pending.Node.Snapshot.ReleaseSimulator();
+            open.Clear();
+            bounded?.Clear();
+            foreach (SearchNode dropped in noveltyDropped) dropped.Snapshot.ReleaseSimulator();
+            noveltyDropped.Clear();
+            _research.NoveltyEntries = packed?.Entries ?? novelty.Entries;
+            _research.NoveltyAtoms = packed?.AtomCount ?? novelty.AtomCount;
+            _research.NoveltyPartitions = packed?.Partitions ?? novelty.Partitions;
+            _research.Unary = packed?.Unary ?? novelty.Unary;
+            _research.Binary = packed?.Binary ?? novelty.Binary;
+            _research.Familiar = packed?.Familiar ?? novelty.Familiar;
+        }
+        int NoveltyFor(SearchNode node) => packed is null
+            ? novelty.Evaluate((node.Snapshot.EnemyHp / 10, node.PotionCount), CaptureResearchFeatures(node, options.Features))
+            : packed.Evaluate((node.Snapshot.EnemyHp / 10, node.PotionCount), CapturePackedFacts(node, options.Features));
+        void Enqueue(SearchNode node, bool initialSeed = false, BfwsEscapeBudget? parentEscape = null)
+        {
+            int w = options.Scheduler == "bfws"
+                ? NoveltyFor(node) : 0;
+            if (!initialSeed && options.Scheduler == "bfws" && BfwsResearchNovelty.IsPrunedByWidth(w, options.Width, options.PruneNonNovel))
+            {
+                if (parentEscape?.TryAdmit() != true)
+                {
+                    _research.NonNovelPruned++;
+                    noveltyDropped.Add(node);
+                    return;
+                }
+                _research.FamiliarAdmitted++;
+            }
+            BfwsEscapeBudget? escape = options.Scheduler == "bfws" && options.PruneNonNovel && options.FamiliarAllowance > 0
+                ? initialSeed || w <= options.Width ? new(options.FamiliarAllowance) : parentEscape
+                : null;
+            var rank = options.Scheduler == "exact"
+                ? (-(double)node.ActionCount, 0d, sequence++)
+                : options.Scheduler == "gbfs" ? (-node.Score, 0d, sequence++) : ((double)w, -node.Score, sequence++);
+            if (bounded is null) open.Enqueue((node, escape), rank);
+            else if (bounded.Enqueue((node, escape), rank, out var evicted))
+            {
+                _research.OpenDropped++;
+                noveltyDropped.Add(evicted.Node);
+            }
+            _research.PeakOpen = Math.Max(_research.PeakOpen, OpenCount());
+        }
+    }
+
+    private IReadOnlyList<BfwsFact> CapturePackedFacts(SearchNode node, string mode)
+    {
+        List<BfwsFact> facts = _research.Facts;
+        facts.Clear();
+        var s = node.Snapshot;
+        ReadOnlySpan<int> values = [s.Energy, s.Stars, s.HandCount, s.ZeroCostPlayableCount,
+            s.ReachableHandValue, s.PersistentBuffValue, s.LatentSetupValue, s.FutureResourceValue,
+            s.RetainedAttackValue, s.ReplayPotentialValue, s.DelayedDamageValue, s.ReactiveDamageValue,
+            s.StrategicEffects.DamagePotential, s.StrategicEffects.PreventionPotential,
+            s.StrategicEffects.ResourcePotential, s.StrategicEffects.CardAccessPotential,
+            s.StrategicEffects.ScalingPotential, s.EnemyStrengthSuppression, s.EnemyWeakTurns, s.EnemyVulnerableTurns];
+        for (int i = 0; i < values.Length; i++)
+            if (values[i] > 0)
+                facts.Add(new(BfwsFactKind.Scalar, i, Value: i < 4 || i >= 18 ? Math.Min(7, values[i]) : Math.Min(7, 1 + BitOperations.Log2((uint)values[i]))));
+        if (mode != "structured") return facts;
+        facts.Add(new(BfwsFactKind.Energy, Value: s.Energy));
+        facts.Add(new(BfwsFactKind.Block, Value: s.PlayerBlock / 5));
+        facts.Add(new(BfwsFactKind.Hp, Value: s.PlayerHp / 5));
+        var simulator = (CombatPredictionSimulator)s.Simulator;
+        var playerState = simulator.State.GetPlayerCombatState(_player);
+        for (int zone = 0; zone < 4; zone++)
+        {
+            var cards = zone switch { 0 => playerState.Hand.Cards, 1 => playerState.DrawPile.Cards,
+                2 => playerState.DiscardPile.Cards, _ => playerState.ExhaustPile.Cards };
+            _research.ZoneCounts.Clear(); _research.ZoneOrder.Clear();
+            foreach (var card in cards)
+            {
+                var key = (card.Preview.Id.Entry, card.Preview.CurrentUpgradeLevel);
+                if (_research.ZoneCounts.TryGetValue(key, out int count)) _research.ZoneCounts[key] = count + 1;
+                else { _research.ZoneCounts.Add(key, 1); _research.ZoneOrder.Add(key); }
+            }
+            foreach (var key in _research.ZoneOrder)
+                facts.Add(new(BfwsFactKind.Zone, zone, key.Id, key.Upgrade, Math.Min(3, _research.ZoneCounts[key])));
+        }
+        for (int i = 0; i < Math.Min(3, playerState.DrawPile.Cards.Count); i++)
+            facts.Add(new(BfwsFactKind.Draw, i, playerState.DrawPile.Cards[i].Preview.Id.Entry));
+        var combat = (SimulatedCombatState)simulator.State.CombatState;
+        foreach (var power in combat.EffectivePowers())
+            facts.Add(new(BfwsFactKind.Power, ReferenceEquals(power.Owner, _player.Creature) ? 0 : 1, power.Id.Entry, power.Amount));
+        return facts;
+    }
+
+    private IEnumerable<string> CaptureResearchFeatures(SearchNode node, string mode)
+    {
+        var s = node.Snapshot;
+        int[] values = [s.Energy, s.Stars, s.HandCount, s.ZeroCostPlayableCount,
+            s.ReachableHandValue, s.PersistentBuffValue, s.LatentSetupValue, s.FutureResourceValue,
+            s.RetainedAttackValue, s.ReplayPotentialValue, s.DelayedDamageValue, s.ReactiveDamageValue,
+            s.StrategicEffects.DamagePotential, s.StrategicEffects.PreventionPotential,
+            s.StrategicEffects.ResourcePotential, s.StrategicEffects.CardAccessPotential,
+            s.StrategicEffects.ScalingPotential, s.EnemyStrengthSuppression, s.EnemyWeakTurns, s.EnemyVulnerableTurns];
+        for (int i = 0; i < values.Length; i++)
+            if (values[i] > 0) yield return $"scalar:{i}:{(i < 4 || i >= 18 ? Math.Min(7, values[i]) : Math.Min(7, 1 + BitOperations.Log2((uint)values[i])))}";
+        if (mode != "structured") yield break;
+        yield return $"energy:{s.Energy}";
+        yield return $"block:{s.PlayerBlock / 5}";
+        yield return $"hp:{s.PlayerHp / 5}";
+        var simulator = (CombatPredictionSimulator)s.Simulator;
+        var playerState = simulator.State.GetPlayerCombatState(_player);
+        var zones = new[] { playerState.Hand.Cards, playerState.DrawPile.Cards, playerState.DiscardPile.Cards, playerState.ExhaustPile.Cards };
+        for (int zone = 0; zone < zones.Length; zone++)
+        {
+            foreach (var group in zones[zone].GroupBy(c => (c.Preview.Id.Entry, c.Preview.CurrentUpgradeLevel)))
+                yield return $"zone:{zone}:{group.Key.Entry}:{group.Key.CurrentUpgradeLevel}:{Math.Min(3, group.Count())}";
+        }
+        // Preserve leading draw order without physical IDs, RNG counters or action history.
+        for (int i = 0; i < Math.Min(3, playerState.DrawPile.Cards.Count); i++)
+            yield return $"draw:{i}:{playerState.DrawPile.Cards[i].Preview.Id.Entry}";
+        var combat = (SimulatedCombatState)simulator.State.CombatState;
+        foreach (var power in combat.EffectivePowers())
+            yield return $"power:{(ReferenceEquals(power.Owner, _player.Creature) ? "player" : "enemy")}:{power.Id.Entry}:{power.Amount}";
+    }
+
+    // Complete physical-card/target action tree for explicitly choice-free, potion-free small roots.
+    // No TT, dominance, top-k or heuristic pruning. Finite action/turn limits are explicit.
+    private IEnumerable<SearchNode> ExpandResearchRaw(SearchNode parent)
+    {
+        _run.Expanded++;
+        var simulator = (CombatPredictionSimulator)parent.Snapshot.Simulator;
+        var combat = (SimulatedCombatState)simulator.State.CombatState;
+        var hand = simulator.State.GetPlayerCombatState(_player).Hand.Cards;
+        List<PlanAction> actions = [];
+        for (int i = 0; i < hand.Count; i++)
+        {
+            var card = hand[i];
+            if (!combat.CanPlayCard(simulator, card)) continue;
+            string cardKey = CardChoiceSupport.ChoiceCardKey(card);
+            int occurrence = hand.Take(i).Count(c => c.Preview.Id.Entry == card.Preview.Id.Entry);
+            int stateOccurrence = hand.Take(i).Count(c => CardChoiceSupport.ChoiceCardKey(c) == cardKey);
+            foreach (var (index, target) in TargetsFor(card, simulator))
+                actions.Add(new PlanAction(PlanActionKind.PlayCard, parent.Turn, card.Preview.Id.Entry,
+                    occurrence, index, target?.CombatId, CardStateKey: cardKey, CardStateOccurrence: stateOccurrence,
+                    CardUpgradeLevel: card.Preview.CurrentUpgradeLevel));
+        }
+        actions.Add(new PlanAction(PlanActionKind.EndTurn, parent.Turn));
+        foreach (PlanAction action in actions)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            var s = ReplayAction(parent, action);
+            if (s.HasRisk || s.BoundaryReason != SearchBoundaryReason.None || BuildPrimaryCardChoiceSpec(s) != null)
+            {
+                s.ReleaseSimulator();
+                throw new InvalidOperationException($"Finite raw fixture contains a choice or unsupported boundary: {action.CardId}.");
+            }
+            bool terminal = s.PlayerDead || s.AllEnemiesDead;
+            SearchNode child = new(action with { EndsPlayerTurn = s.Turn > parent.Turn }, parent.ActionCount + 1,
+                s.PotionUseCount, s.PotionStrategicCost, s.Turn, parent.Traits, 0, s.Score, s.StateKey,
+                s.HasRisk, s.BoundaryReason, terminal, parent, s, parent.CombatProgress.Advance(s))
+                { CumulativeEnemyHpLost = AccumulateEnemyHpLost(parent, s) };
+            if (terminal || s.Turn > parent.Turn)
+            {
+                SearchNode start = FindTurnStart(parent);
+                int block = s.Turn > parent.Turn ? parent.Snapshot.PlayerBlock : s.PlayerBlock;
+                child = child with { Outcome = new TurnOutcome(action.Turn,
+                    Math.Max(0, s.CumulativePlayerHpLost - start.Snapshot.CumulativePlayerHpLost),
+                    Math.Max(0, s.RecoveredPlayerHp - start.Snapshot.RecoveredPlayerHp),
+                    child.CumulativeEnemyHpLost - start.CumulativeEnemyHpLost, 0, block, block,
+                    s.Turn > parent.Turn ? parent.Snapshot.Energy : s.Energy) };
+            }
+            yield return child;
+        }
+    }
+}
diff --git a/src/Search/CombatSearchCoordinator.NoveltyPortfolio.cs b/src/Search/CombatSearchCoordinator.NoveltyPortfolio.cs
new file mode 100644
index 0000000..170c437
--- /dev/null
+++ b/src/Search/CombatSearchCoordinator.NoveltyPortfolio.cs
@@ -0,0 +1,58 @@
+using System.Diagnostics;
+
+namespace CombatSolver;
+
+internal static partial class CombatSearchCoordinator
+{
+    private static SolverResult RunNoveltyPortfolioPass(
+        CombatRootSnapshot root, SolverDisplayNames names, BattleDamageSnapshot damage,
+        SearchPolicySnapshot policy, SolverSearchProfile profile, Stopwatch clock,
+        SolverPotionPolicy? potionOverride, CancellationToken cancellation,
+        Action<SolverProgress>? progress, Action<SolverResult>? publish,
+        Func<SolverSearchProfile, SolverResult> solveBaseline)
+    {
+        BfwsResearchOptions options = policy.Research!;
+        if (options.ExplorationTimeDivisor < 2 || options.ExplorationMaxNodes < 1)
+            throw new InvalidOperationException("Exploration requires a bounded share of the request.");
+        SearchRequestWorkTotals totals = policy.RequestWorkTotals!;
+        long expandedBefore = totals.Snapshot().ExpandedNodes;
+        var explorationProfile = profile with
+        {
+            SoftTimeBudgetMilliseconds = Math.Max(1, profile.SoftTimeBudgetMilliseconds / options.ExplorationTimeDivisor),
+            MaxExpandedNodes = Math.Min(profile.MaxExpandedNodes, options.ExplorationMaxNodes),
+        };
+        SolverResult exploration = new CombatBeamSolver(root, names, damage,
+            policy with { Research = options with { Scheduler = "bfws" } }, cancellation,
+            progress, explorationProfile, potionPolicyOverride: potionOverride).Solve();
+        long explorationExpanded = totals.Snapshot().ExpandedNodes - expandedBefore;
+        long explorationElapsed = clock.ElapsedMilliseconds;
+        object? explorationDetails = exploration.ExperimentalBfws;
+        if (IsCompleteVictory(exploration)) publish?.Invoke(exploration);
+        bool settled = exploration.ResultScope != SolverResultScope.SearchCompletion
+            || !policy.PotionStrategy.HasForcedDirectives && HasReachedAcceptableBattleHpLoss(policy, exploration);
+        int remainingNodes = (int)Math.Max(0, profile.MaxExpandedNodes - explorationExpanded);
+        int remainingMs = (int)Math.Max(0, profile.SoftTimeBudgetMilliseconds - clock.ElapsedMilliseconds);
+        if (settled || remainingNodes == 0 || remainingMs == 0)
+        {
+            exploration.ExperimentalBfws = new { stop = "portfolio_exploration", explorationExpanded,
+                explorationElapsed, explorationDetails, baselineRan = false, settled, remainingNodes, remainingMs };
+            return exploration;
+        }
+        cancellation.ThrowIfCancellationRequested();
+        SolverResult baseline = solveBaseline(profile with
+        {
+            MaxExpandedNodes = remainingNodes,
+            SoftTimeBudgetMilliseconds = remainingMs,
+        });
+        bool selectExploration = baseline.ResultScope == SolverResultScope.SearchCompletion
+            && IsCompleteVictory(exploration)
+            && IsBetterPotionPolicyResult(root, policy, exploration, baseline);
+        SolverResult selected = selectExploration ? exploration : baseline;
+        selected.ExperimentalBfws = new { stop = "portfolio", explorationExpanded, explorationElapsed,
+            explorationDetails, baselineRan = true, selected = selectExploration ? "exploration" : "beam",
+            explorationLoss = exploration.ProjectedBattleHpLost, explorationWon = IsCompleteVictory(exploration),
+            baselineLoss = baseline.ProjectedBattleHpLost, baselineWon = IsCompleteVictory(baseline),
+            remainingNodes, remainingMs };
+        return selected;
+    }
+}
diff --git a/src/Testing/UnattendedTestRunner.BfwsResearch.cs b/src/Testing/UnattendedTestRunner.BfwsResearch.cs
new file mode 100644
index 0000000..e642945
--- /dev/null
+++ b/src/Testing/UnattendedTestRunner.BfwsResearch.cs
@@ -0,0 +1,96 @@
+using System.Text.Json;
+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Entities.Players;
+
+namespace CombatSolver;
+
+internal sealed partial class UnattendedTestRunner
+{
+    private async Task RunBfwsResearchAsync(CombatState combat, Player player)
+    {
+        string area = _request.EvidenceDirectory ?? throw new InvalidOperationException("Research requires output directory.");
+        string input = File.ReadAllText(Path.Combine(area, "research-options.json"));
+        BfwsResearchOptions[] variants = input.TrimStart().StartsWith('[')
+            ? JsonSerializer.Deserialize<BfwsResearchOptions[]>(input, UnattendedTestFiles.JsonOptions)!
+            : [JsonSerializer.Deserialize<BfwsResearchOptions>(input, UnattendedTestFiles.JsonOptions)!];
+        if (variants.Length is < 1 or > 5 || variants.Any(v => v == null)) throw new InvalidDataException("Research batch requires 1..5 variants.");
+        ContinuationStamp before = ContinuationStamp.CaptureLive(combat);
+        var enemies = combat.Enemies.ToArray();
+        var liveBefore = enemies.Select(enemy => CaptureActual(combat, player, enemy)).ToArray();
+        CombatRootSnapshot root = CombatRootSnapshot.Capture(combat);
+        var rootBefore = CaptureKnownRouteRootStates(root, player, enemies);
+        var names = SolverDisplayNames.Capture(combat);
+        var damage = BattleDamageTracker.Observe(combat);
+        var settings = SolverSettings.Capture();
+        var captured = SolverController.CaptureSearchPolicy(settings, combat, false, null);
+        bool smart = File.Exists(Path.Combine(area, "smart.flag"));
+        bool native = File.Exists(Path.Combine(area, "native.flag"));
+        if (native && variants.Length != 1) throw new InvalidOperationException("Native deployment requires one selected variant.");
+        List<object> reports = [];
+        using CancellationTokenSource cancellation = new(TimeSpan.FromSeconds(Math.Max(1, _request.TimeoutSeconds - _stopwatch.Elapsed.TotalSeconds)));
+        foreach (BfwsResearchOptions options in variants)
+        {
+            var policy = captured with { Research = options, MaxDegreeOfParallelism = 1, FixedBudget = true,
+                Profile = captured.Profile with { SoftTimeBudgetMilliseconds = captured.BudgetOverrideMilliseconds ?? captured.Profile.SoftTimeBudgetMilliseconds } };
+            SetStage($"bfws_research_{options.Scheduler}_{options.Features}_{options.Width}");
+            // A direct single solver with explicit potions disabled isolates scheduling.
+            SolverResult result = await Task.Run(() => smart
+                ? CombatSearchCoordinator.Solve(root, names, damage, policy, cancellation.Token, null)
+                : new CombatBeamSolver(root, names, damage, policy, cancellation.Token,
+                    searchProfile: policy.Profile, potionPolicyOverride: SolverPotionPolicy.Disabled,
+                    maximumPotionUses: 0).Solve(), cancellation.Token);
+            _writer.CaptureSolverResult(result);
+            var report = new { options, policy.Profile, ordinal = reports.Count,
+                result = SolverDiagnostics.DescribeResult(result), research = result.ExperimentalBfws,
+                actions = result.BestNode.Actions, effectivePolicy = CombatBugReportExporter.LatestEffectivePolicy };
+            reports.Add(report);
+            _writer.WriteGeneratedArtifact($"research-{reports.Count - 1}.json", report);
+            _writer.WriteGeneratedArtifact("research-batch.json", reports);
+            _writer.WriteGeneratedArtifact("research.json", report);
+            if (ContinuationStamp.CaptureLive(combat) != before) throw new InvalidOperationException("Research changed live root.");
+            var rootAfter = CaptureKnownRouteRootStates(root, player, enemies);
+            for (int i = 0; i < enemies.Length; i++)
+            {
+                AssertSnapshotEqual(liveBefore[i], CaptureActual(combat, player, enemies[i]), "BfwsResearch", "live_root");
+                AssertSnapshotEqual(rootBefore[i], rootAfter[i], "BfwsResearch", "shadow_root");
+            }
+            _completedChecks.Add($"BfwsResearch:{reports.Count}:LiveAndShadowRootUnchanged");
+            if (native)
+            {
+                if (!result.Snapshot.AllEnemiesDead || result.Snapshot.PlayerDead || result.Snapshot.HasRisk)
+                    throw new InvalidOperationException("Native research deployment requires a predicted safe victory.");
+                using var ledger = new CombatReplayOutcome(combat);
+                SolverController.SetStopFullAutoOnCombatEnd(false, persist: false);
+                SolverController.SetStopFullAutoOnDeathTurn(false, persist: false);
+                SolverController.SetStopFullAutoOnWorseRecalculation(false, persist: false);
+                _protocolHost.EnableAutomaticTurnSearch();
+                bool observedEnd = false;
+                try
+                {
+                    SolverController.StartBfwsResearchDeployment(_host, combat, result, state =>
+                    {
+                        observedEnd = true;
+                        ledger.Complete(state);
+                    });
+                    while (CombatManager.Instance.IsInProgress)
+                    {
+                        EnsureWithinDeadline();
+                        if (SolverController.UnexpectedReplanCount != 0 || SolverController.LastSearchFailureForTesting != null)
+                            throw new InvalidOperationException("Native research deployment replanned or failed: " + SolverController.ReplanAuditForBugReport);
+                        await NextFrameAsync();
+                    }
+                    var outcome = ledger.Capture(combat, ended: true);
+                    _writer.WriteGeneratedArtifact("native-outcome.json", new { outcome, expectedLoss = result.ProjectedBattleHpLost,
+                        expectedPotions = result.ProjectedBattlePotionCount, unexpectedReplans = SolverController.UnexpectedReplanCount,
+                        observedEnd, finalPlayerMaxHp = player.Creature.MaxHp, forensicOutcome = CombatBugReportExporter.CaptureOutcome(combat) });
+                    if (!observedEnd || !outcome.Survived || outcome.FinalEnemyHp != 0 || outcome.HpLost != result.ProjectedBattleHpLost
+                        || outcome.Potions.Length != result.ProjectedBattlePotionCount || outcome.UnattributedHpLoss != 0
+                        || SolverController.UnexpectedReplanCount != 0)
+                        throw new InvalidOperationException("Native battle outcome differed from the frozen initial result.");
+                    _completedChecks.Add("BfwsResearch:NativeVictory:ExactLossPotions:NoUnexpectedReplans");
+                }
+                finally { CombatReplayRecording.TestCombatEndObserver = null; }
+            }
+        }
+    }
+}
