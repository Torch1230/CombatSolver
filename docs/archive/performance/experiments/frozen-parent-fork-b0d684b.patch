@@ -0,0 +1,15 @@
+using System.Collections.Concurrent;
+namespace CombatSolver;
+internal sealed class LocalFrozenParentFork(SimulationSnapshot source)
+{
+    public SimulationSnapshot Source { get; } = source;
+    public bool Inspected;
+    public volatile bool Eligible;
+    private sealed class Counts { public long Fast, Slow, EligibleParents, FallbackParents; }
+    private static readonly ConcurrentBag<Counts> Threads = new();
+    [ThreadStatic] private static Counts? _counts;
+    private static Counts Current { get { if(_counts==null) { _counts=new();Threads.Add(_counts); } return _counts; } }
+    public static void Record(bool fast) { if(fast) Current.Fast++; else Current.Slow++; }
+    public void Publish(bool eligible) { Inspected=true;Eligible=eligible;if(eligible)Current.EligibleParents++;else Current.FallbackParents++; }
+    public static void Dump() => System.IO.File.WriteAllText("/tmp/frozen-parent-probe.json",System.Text.Json.JsonSerializer.Serialize(new {fast=Threads.Sum(t=>t.Fast),slow=Threads.Sum(t=>t.Slow),eligibleParents=Threads.Sum(t=>t.EligibleParents),fallbackParents=Threads.Sum(t=>t.FallbackParents)}));
+}
