<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(CecilAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireCecilPath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(CecilAssemblyPath)')" Text="Pass -p:CecilAssemblyPath=/path/to/Mono.Cecil.dll (for example from an installed ILSpy)." />
  </Target>
</Project>
