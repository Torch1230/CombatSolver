<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants Condition="'$(StateStoreSource)' == ''">$(DefineConstants);CHECK_ENTRY_COUNTS</DefineConstants>
    <StateStoreSource Condition="'$(StateStoreSource)' == ''">../../src/Engine/Common/PredictionStateStore.cs</StateStoreSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(StateStoreSource)" Link="PredictionStateStore.cs" />
  </ItemGroup>
</Project>
