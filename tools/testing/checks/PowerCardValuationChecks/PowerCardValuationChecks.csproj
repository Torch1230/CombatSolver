<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/PowerCardValuationContracts.cs" Link="PowerCardValuationContracts.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PlanHorizonPolicy.cs" Link="PlanHorizonPolicy.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/IPowerCardValuationModel.cs" Link="IPowerCardValuationModel.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/PowerCardValuationRegistry.cs" Link="PowerCardValuationRegistry.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/PowerCardValuationModels.cs" Link="PowerCardValuationModels.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/PowerCardValuationRegistration.cs" Link="PowerCardValuationRegistration.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/PowerRouteAdmission.cs" Link="PowerRouteAdmission.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/PowerCardValueFacts.cs" Link="PowerCardValueFacts.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Projection/*.cs"
             Exclude="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Projection/PowerCardProjectionSupport.cs;$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Projection/PowerCardMechanismFacts.cs;$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Projection/SilentPowerOpeningProjection.cs;$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Projection/SilentShivPowerProjection.cs;$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Projection/SilentPoisonPowerProjection.cs;$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Projection/SilentDamageDefensePowerProjection.cs"
             LinkBase="Projection" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Commitments/PowerCommitment.cs" LinkBase="Commitments" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Commitments/PowerCommitmentLifecycle.cs" LinkBase="Commitments" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Commitments/PowerCommitmentSeatPolicy.cs" LinkBase="Commitments" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Commitments/PowerActivationInvestmentPolicy.cs" LinkBase="Commitments" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Cards/**/*.cs"
             Exclude="$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Cards/**/*PowerTriggerEvidence.cs;$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Cards/**/*PowerOpeningProjection.cs;$(CombatSolverRepositoryRoot)src/Search/PowerCardValuation/Cards/**/*PowerCommitmentEvidence.cs"
             LinkBase="Cards" />
  </ItemGroup>
</Project>
