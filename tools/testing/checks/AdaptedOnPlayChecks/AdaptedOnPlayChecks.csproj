<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(CombatSolverRepositoryRoot)local.props" Condition="Exists('$(CombatSolverRepositoryRoot)local.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CombatSolverRepositoryRoot)src/Prediction/AdaptedCardOnPlayMirrors.cs" Link="AdaptedCardOnPlayMirrors.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Prediction/PredictionModPatchAudit.cs" Link="PredictionModPatchAudit.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Engine/Common/Mirrors/MethodMirrorRegistry.cs" Link="MethodMirrorRegistry.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Engine/Common/Mirrors/MethodMirrorRegistryDescriptor.cs" Link="MethodMirrorRegistryDescriptor.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Engine/Common/Mirrors/MethodMirrorContext.cs" Link="MethodMirrorContext.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Engine/Common/Mirrors/MirrorMethodSpec.cs" Link="MirrorMethodSpec.cs" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Engine/Common/PredictionUnsupportedException.cs" Link="PredictionUnsupportedException.cs" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" />
  </ItemGroup>
  <Target Name="ValidateReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/0Harmony.dll')" Text="Pass -p:Sts2DataDir=... for the supported game's Harmony assembly." />
  </Target>
</Project>
