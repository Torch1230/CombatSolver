<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CardTargetingSource Condition="'$(CardTargetingSource)' == ''">$(MSBuildThisFileDirectory)../../src/Engine/InCombat/Simulation/CombatPredictionSimulator.CardTargeting.cs</CardTargetingSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CardTargetingSource)" Link="Production/CardTargeting.cs" />
  </ItemGroup>
</Project>
