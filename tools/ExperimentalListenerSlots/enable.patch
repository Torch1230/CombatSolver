+using MegaCrit.Sts2.Core.Models;
+using CombatSolver.Engine.Common;
+
+namespace CombatSolver;
+
+internal sealed partial class SimulatedCombatState
+{
+    void IPredictedCardListenerObserver.CardPreviewReplaced(
+        PredictedCard card,
+        CardModel previousPreview)
+    {
+        if (!TryReplaceCardListenerSlots(card, previousPreview))
+            InvalidateBaseHookListeners();
+    }
+
+    void IPredictedCardListenerObserver.CardListenerStructureChanged()
+        => InvalidateBaseHookListeners();
+
+    private int FindCardListenerStart(
+        List<AbstractModel> effectiveListeners,
+        IReadOnlyList<AbstractModel> baseListeners)
+    {
+        if (_baseCardHookListenerStart < 0 || _baseCardHookListenerStart >= baseListeners.Count)
+            return -1;
+        AbstractModel firstCard = baseListeners[_baseCardHookListenerStart];
+        for (int index = 0; index < effectiveListeners.Count; index++)
+        {
+            if (ReferenceEquals(effectiveListeners[index], firstCard))
+                return index;
+        }
+        return -1;
+    }
+
+    private bool TryReplaceCardListenerSlots(PredictedCard card, CardModel previousPreview)
+    {
+        if (!CanReuseHookListenerCache || _baseHookListeners is null || card.HookListenerSlot < 0)
+            return false;
+        CardModel preview = card.Preview;
+        if (previousPreview.HasBeenRemovedFromState || preview.HasBeenRemovedFromState
+            || !ReferenceEquals(previousPreview.Owner, preview.Owner)
+            || (previousPreview.Affliction is null) != (preview.Affliction is null)
+            || (previousPreview.Enchantment is null) != (preview.Enchantment is null))
+        {
+            return false;
+        }
+
+        int baseSlot = _baseCardHookListenerStart + card.HookListenerSlot;
+        int effectiveSlot = _effectiveCardHookListenerStart < 0
+            ? -1
+            : _effectiveCardHookListenerStart + card.HookListenerSlot;
+        int runSlot = effectiveSlot < 0 ? -1 : _rootRunHookListeners.Length + effectiveSlot;
+        // Slots are hints owned by this cached topology. Validate every published projection
+        // before changing one; an insertion/removal or opaque topology uses the full rebuild.
+        if (!MatchesCardListenerSlots(_baseHookListeners, baseSlot, previousPreview)
+            || (_effectiveHookListeners is not null
+                && !MatchesCardListenerSlots(_effectiveHookListeners, effectiveSlot, previousPreview))
+            || (_effectiveRunHookListeners is not null
+                && !MatchesCardListenerSlots(_effectiveRunHookListeners, runSlot, previousPreview)))
+        {
+            return false;
+        }
+
+        ReadOnlySpan<AbstractModel> replacements = preview.Affliction is { } affliction
+            ? preview.Enchantment is { } enchantment
+                ? [preview, affliction, enchantment]
+                : [preview, affliction]
+            : preview.Enchantment is { } onlyEnchantment
+                ? [preview, onlyEnchantment]
+                : [preview];
+        IReadOnlyList<AbstractModel> updatedBase = ImmutableListenerList<AbstractModel>.Replace(
+            _baseHookListeners, baseSlot, replacements);
+        IReadOnlyList<AbstractModel>? updatedEffective = ReferenceEquals(_effectiveHookListeners, _baseHookListeners)
+            ? updatedBase
+            : _effectiveHookListeners is null
+                ? null
+                : ImmutableListenerList<AbstractModel>.Replace(_effectiveHookListeners, effectiveSlot, replacements);
+        IReadOnlyList<AbstractModel>? updatedRun = ReferenceEquals(_effectiveRunHookListeners, _effectiveHookListeners)
+            ? updatedEffective
+            : _effectiveRunHookListeners is null
+                ? null
+                : ImmutableListenerList<AbstractModel>.Replace(_effectiveRunHookListeners, runSlot, replacements);
+        _baseHookListeners = updatedBase;
+        _effectiveHookListeners = updatedEffective;
+        _effectiveRunHookListeners = updatedRun;
+        // A preview replacement cannot change Power identity, membership or relative order.
+        // Preserve that independent projection while replacing the card and its attachments.
+        return true;
+    }
+
+    private static bool MatchesCardListenerSlots(
+        IReadOnlyList<AbstractModel> listeners,
+        int start,
+        CardModel preview)
+    {
+        int count = 1 + (preview.Affliction is null ? 0 : 1) + (preview.Enchantment is null ? 0 : 1);
+        if (start < 0 || start > listeners.Count - count || !ReferenceEquals(listeners[start], preview))
+            return false;
+        int index = start + 1;
+        if (preview.Affliction is { } affliction && !ReferenceEquals(listeners[index++], affliction))
+            return false;
+        return preview.Enchantment is not { } enchantment || ReferenceEquals(listeners[index], enchantment);
+    }
+}
