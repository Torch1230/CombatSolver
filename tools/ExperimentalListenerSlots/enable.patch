+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Extensions;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Models.Cards;
+using MegaCrit.Sts2.Core.Models.Enchantments;
+using CombatSolver.Engine.Common;
+using CombatSolver.Engine.InCombat.Simulation;
+
+namespace CombatSolver;
+
+internal sealed partial class UnattendedTestRunner
+{
+    private static void AssertListenerSlotReplacementAcrossFork(CombatState combat, Player player)
+    {
+        SimulatedCombatState parentCombat = new(combat);
+        CombatPredictionSimulator parent = new(parentCombat);
+        List<PredictedCard> generated = [];
+        for (int index = 0; index < 65; index++)
+        {
+            PredictedCard card = PredictedCard.Create(ModelDb.Card<PommelStrike>(), player);
+            if (!parent.AddToPile(card, PileType.Discard).Success)
+                throw new InvalidOperationException("Listener slot 测试无法建立宽卡牌列表。");
+            generated.Add(card);
+        }
+        generated[31].Enchant(ModelDb.Enchantment<Clone>().ToMutable(), 1m);
+        ICombatPredictionHookListenerSource parentSource = parentCombat;
+        IReadOnlyList<AbstractModel> parentListeners = parentSource.HookListeners;
+        IReadOnlyList<AbstractModel> parentRunListeners = parentSource.RunHookListeners;
+        AbstractModel[] parentBefore = parentListeners.ToArray();
+        AbstractModel[] parentRunBefore = parentRunListeners.ToArray();
+        CombatPredictionSimulator child = parent.Fork();
+        SimulatedCombatState childCombat = (SimulatedCombatState)child.State.CombatState;
+        ICombatPredictionHookListenerSource childSource = childCombat;
+        SimPlayerCombatState childPlayer = child.State.GetPlayerCombatState(player);
+
+        foreach (PredictedCard parentCard in new[] { generated[31], generated[32], generated[64] })
+        {
+            PredictedCard childCard = childPlayer.FindCard(parentCard.Original)
+                ?? throw new InvalidOperationException("Listener slot 测试找不到 Fork 后的卡牌。");
+            IReadOnlyList<PowerModel> powersBefore = childCombat.EffectivePowers();
+            IReadOnlyList<AbstractModel> before = childSource.HookListeners;
+            IReadOnlyList<AbstractModel> runBefore = childSource.RunHookListeners;
+            AbstractModel[] previousEntries = before.ToArray();
+            AbstractModel[] previousRunEntries = runBefore.ToArray();
+            CardModel previousPreview = childCard.Preview;
+            childCard.MutablePreview.BaseReplayCount++;
+            IReadOnlyList<AbstractModel> after = childSource.HookListeners;
+            IReadOnlyList<AbstractModel> runAfter = childSource.RunHookListeners;
+            AssertListenerPreviewReplacement(previousEntries, after, previousPreview, childCard.Preview);
+            AssertListenerPreviewReplacement(previousRunEntries, runAfter, previousPreview, childCard.Preview);
+            if (!before.SequenceEqual(previousEntries) || !runBefore.SequenceEqual(previousRunEntries))
+                throw new InvalidOperationException("Listener slot 更新改写了已发布的旧快照。");
+            if (!ReferenceEquals(powersBefore, childCombat.EffectivePowers()))
+                throw new InvalidOperationException("仅 preview 身份更新丢弃了独立 Power 投影。");
+            childCard.MutablePreview.BaseReplayCount++;
+            if (!ReferenceEquals(after, childSource.HookListeners))
+                throw new InvalidOperationException("原位字段更新不应替换 listener 快照。");
+        }
+
+        if (!parentListeners.SequenceEqual(parentBefore)
+            || !parentRunListeners.SequenceEqual(parentRunBefore)
+            || !ReferenceEquals(parentListeners, parentSource.HookListeners)
+            || !ReferenceEquals(parentRunListeners, parentSource.RunHookListeners))
+        {
+            throw new InvalidOperationException("Listener slot 更新污染了父分支缓存。");
+        }
+        CombatPredictionSimulator grandchild = child.Fork();
+        ICombatPredictionHookListenerSource grandchildSource =
+            (SimulatedCombatState)grandchild.State.CombatState;
+        IReadOnlyList<AbstractModel> grandchildBefore = grandchildSource.HookListeners;
+        AbstractModel[] grandchildEntries = grandchildBefore.ToArray();
+        PredictedCard grandchildCard = grandchild.State.GetPlayerCombatState(player).FindCard(generated[64].Original)
+            ?? throw new InvalidOperationException("Listener slot 测试找不到第二次 Fork 的卡牌。");
+        CardModel grandchildPreviousPreview = grandchildCard.Preview;
+        grandchildCard.MutablePreview.BaseReplayCount++;
+        AssertListenerPreviewReplacement(
+            grandchildEntries, grandchildSource.HookListeners, grandchildPreviousPreview, grandchildCard.Preview);
+        if (!grandchildBefore.SequenceEqual(grandchildEntries))
+            throw new InvalidOperationException("二次 Fork 的 slot 更新改写了旧快照。");
+    }
+
+    private static void AssertListenerPreviewReplacement(
+        IReadOnlyList<AbstractModel> before,
+        IReadOnlyList<AbstractModel> after,
+        CardModel previousPreview,
+        CardModel preview)
+    {
+        if (before.Count != after.Count)
+            throw new InvalidOperationException("Preview 替换改变了 listener 拓扑宽度。");
+        int replacedCards = 0;
+        for (int index = 0; index < before.Count; index++)
+        {
+            AbstractModel expected = before[index];
+            if (ReferenceEquals(expected, previousPreview))
+            {
+                expected = preview;
+                replacedCards++;
+            }
+            else if (previousPreview.Affliction is not null && ReferenceEquals(expected, previousPreview.Affliction))
+                expected = preview.Affliction!;
+            else if (previousPreview.Enchantment is not null && ReferenceEquals(expected, previousPreview.Enchantment))
+                expected = preview.Enchantment!;
+            if (!ReferenceEquals(expected, after[index]))
+                throw new InvalidOperationException($"Preview slot 替换改变了 listener 顺序或身份：index={index}。");
+        }
+        if (replacedCards != 1)
+            throw new InvalidOperationException($"Preview slot 测试预期替换一张卡牌，实际={replacedCards}。");
+    }
+}
